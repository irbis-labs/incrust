#!/usr/bin/env bash

set -euo pipefail

fail=0

# Block pushing with active `[patch.*]` overrides in any tracked Cargo.toml.
while IFS= read -r file; do
  # Note: POSIX ERE escaping: `\[` matches literal `[`. Using `\\[` makes the
  # regex invalid on macOS/BSD grep ("brackets ([ ]) not balanced").
  if grep -nE '^[[:space:]]*\[patch\.' "$file" >/dev/null; then
    echo "ERROR: [patch.*] sections found in $file:" >&2
    grep -nE '^[[:space:]]*\[patch\.' "$file" >&2 || true
    fail=1
  fi
done < <(git ls-files '*Cargo.toml')

if [ "$fail" -ne 0 ]; then
  echo "Fix: comment out or remove [patch.*] sections before pushing, and publish patched deps upstream first." >&2
  exit 1
fi

# Enforce vendoring for repos that have a `vendor/` tree checked in.
# Vendoring updates are performed via: `ic vendor update`.
if [ -d ./vendor ]; then
  if [ ! -f ./.cargo/config.toml ]; then
    echo "ERROR: .cargo/config.toml not found. Vendoring must be configured (ic vendor update)." >&2
    exit 1
  fi

  # Note: POSIX ERE does not support `\s` (only PCRE does). Use `[[:space:]]` to
  # avoid false negatives on developer machines.
  if ! grep -qE 'replace-with[[:space:]]*=[[:space:]]*"vendored-sources"' ./.cargo/config.toml; then
    echo "ERROR: .cargo/config.toml does not configure replace-with = \"vendored-sources\"." >&2
    exit 1
  fi
fi
